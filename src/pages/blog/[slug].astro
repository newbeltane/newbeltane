---
import client from '../../../tina/__generated__/client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaBlogPost from '../../components/TinaBlogPost';

export async function getStaticPaths() {
  const { data } = await client.queries.postConnection();
  const posts = data.postConnection.edges || [];

  return posts.map((edge) => {
    const post = edge?.node;
    return {
      params: { slug: post?._sys.filename.toLowerCase() },
      props: { relativePath: post?._sys.relativePath },
    };
  });
}

const { relativePath } = Astro.props;
const response = await client.queries.post({ relativePath: relativePath as string });
const { title, description } = response.data.post;
---

<BaseLayout title={title || ''} description={description || ''}>
  <TinaBlogPost client:load {...response} />
</BaseLayout>

<style is:global>
  .prose p { margin-bottom: 1.5rem; line-height: 1.75; }
  .prose h2, .prose h3, .prose h4 { margin-top: 2rem; margin-bottom: 1rem; font-weight: 700; line-height: 1.3; }
  .prose h2 { font-size: 1.5rem; }
  .prose h3 { font-size: 1.25rem; }
  .prose ul, .prose ol { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .prose ul { list-style-type: disc; }
  .prose ol { list-style-type: decimal; }
  .prose li { margin-bottom: 0.5rem; }
  .prose blockquote { border-left: 4px solid var(--border-strong, #cbd5e1); padding-left: 1rem; font-style: italic; margin-bottom: 1.5rem; color: var(--text-muted, #475569); }
  .prose a { text-decoration: underline; }
</style>
