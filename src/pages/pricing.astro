---
import BaseLayout from '../layouts/BaseLayout.astro';
import client from '../../tina/__generated__/client';
import TinaPricingPage from '../components/TinaPricingPage';

let pageResponse;
try {
  pageResponse = await client.queries.page({ relativePath: 'pricing.md' });
} catch (e) {
  console.warn("TinaCMS: Could not find pricing.md");
}
const pageData = pageResponse?.data?.page;
---

<BaseLayout 
  title={pageData?.title || "Pricing | Newbeltane Tech"} 
  description={pageData?.description || "Transparent, fixed-price web development services."}
>
  {pageResponse ? (
    <TinaPricingPage client:load {...pageResponse} />
  ) : (
    <p style="text-align:center; padding: 4rem;">Error loading pricing data. Please create pricing.md in CMS.</p>
  )}
</BaseLayout>

<style is:global>
  .page-hero { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .page-title { font-size: var(--fs-3xl); margin: 0.75rem 0 1.25rem; }
  .lead { font-size: var(--fs-lg); color: var(--text-secondary); margin-bottom: 2rem; }
  
  /* Custom Flex Grid */
  .pricing-flex-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
    margin-bottom: 4rem;
  }
  .pricing-flex-grid > .pricing-card {
    flex: 0 1 calc(33.333% - 1.35rem);
    width: 100%;
    min-width: 280px;
    max-width: 380px; /* Prevents stretching */
  }
  
  /* 1 column on mobile */
  @media (max-width: 768px) {
    .pricing-flex-grid > .pricing-card {
      flex: 0 1 100%;
      max-width: 100%;
    }
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition: transform 0.2s ease;
  }
  .pricing-card.highlight {
    border-color: var(--accent-cyan);
    box-shadow: 0 8px 30px rgba(6,182,212,0.1);
    transform: translateY(-5px);
  }
  .tier-name { font-size: var(--fs-xl); color: var(--text-primary); margin-bottom: 0.5rem; }
  .tier-price { font-size: var(--fs-3xl); font-weight: 700; color: var(--text-primary); margin-bottom: 1rem; }
  .tier-desc { color: var(--text-secondary); margin-bottom: 2rem; font-size: var(--fs-sm); line-height: 1.5; }
  .tier-features { list-style: none; padding: 0; margin: 0 0 2.5rem 0; flex-grow: 1; }
  .tier-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }
  .check-icon { width: 18px; height: 18px; color: var(--accent-cyan); flex-shrink: 0; }
  
  .ad-hoc-box {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .ad-hoc-box h3 {
    font-size: var(--fs-xl);
    color: var(--text-primary);
    margin-bottom: 1rem;
  }
  .ad-hoc-box p {
    color: var(--text-secondary);
    font-size: var(--fs-base);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .ad-hoc-box p:last-child {
    margin-bottom: 0;
  }
</style>
