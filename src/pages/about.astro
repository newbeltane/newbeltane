---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutPage from '../components/AboutPage';
import client from "../../tina/__generated__/client";

const response = await client.queries.page({
  relativePath: "about.md",
});

// We use 'as any' to bypass TypeScript's strict template checking
const pageData = response.data.page as any;

const seoTitle = pageData.seoTitle || "About | Newbeltane Tech";
const seoDescription = pageData.seoDescription || "Fast, reliable web development and consulting services.";
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <AboutPage client:tina {...(response as any)} />
</BaseLayout>

<style is:global>
  .page-hero { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .about-intro { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .page-title { font-size: var(--fs-3xl); margin: 0.75rem 0 1.25rem; }
  .lead { font-size: var(--fs-lg); color: var(--text-primary); margin-bottom: 1.1rem; }
  .avatar-card { padding: 2rem; text-align: center; }
  .avatar-photo {
    width: 120px; height: 120px; margin: 0 auto 1.25rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    object-fit: cover;
    display: block;
  }
  .avatar-name { font-weight: 700; color: var(--text-primary); font-size: var(--fs-lg); }
  .avatar-role { font-size: var(--fs-sm); color: var(--text-muted); }
  .stack { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .stack-badge {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-card);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }
  .value { padding: clamp(1.5rem, 3vw, 2rem); }
  .value h3 { font-size: var(--fs-lg); margin-bottom: 0.5rem; }
  .value p { font-size: var(--fs-sm); }
  .cta-banner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(circle at 15% 20%, rgba(6,182,212,0.12), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(139,92,246,0.12), transparent 55%),
      var(--bg-card);
  }
  .cta-banner h2 { font-size: var(--fs-xl); margin-bottom: 0.5rem; }
  @media (max-width: 760px) { .about-intro { grid-template-columns: 1fr; } }
</style>
