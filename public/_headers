/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://*.tinajs.io; connect-src 'self' https://*.tinajs.io https://api.web3forms.com https://assets.tina.io https://*.s3.us-east-1.amazonaws.com https://*.s3.amazonaws.com; object-src 'none'; upgrade-insecure-requests

# Long-cache immutable build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
